# The Vite dev server serves modules one by one, which makes for hundreds of
# requests per page load. A connection that reaches its request limit while
# such a load is under way is closed with requests still pending, and the page
# stays blank.
keepalive_requests 1000000;

location / {
    expires epoch;
    etag off;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host "0.0.0.0";

    # enable WebSockets
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";

    proxy_pass http://webapp:8080;
}
